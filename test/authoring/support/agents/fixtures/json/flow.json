  "plugins": [
    {
      "type": "jido.plugin",
      "version": 1,
      "module": "plugins/count-turns",
      "options": [{"$type": "tuple", "items": [{"$type": "atom", "id": "atoms/initial"}, 2]}]
    }
  ],
  "routes": [
    {
      "path": "flow.add",
      "target": "flows/add",
      "kind": "flow",
      "defaults": {"$type": "map", "entries": [[{"$type": "atom", "id": "atoms/amount"}, 2]]},
      "match": null,
      "priority": 0
    }
  ]
}

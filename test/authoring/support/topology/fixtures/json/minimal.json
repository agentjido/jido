  ],
  "groups": [],
  "resources": [],
  "relationships": [],
  "connections": [],
  "includes": [],
  "imports": [],
  "exports": [],
  "startup": {
    "concurrency": 32,
    "max_agents": 10000,
    "retry_interval": 1000,
    "task_timeout": 10000
  }
}
